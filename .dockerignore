# Keep the build context small and make the image reproducible.
#
# node_modules and .next are excluded so the build stage always resolves them
# itself from package-lock.json rather than copying a host-built tree, which may
# contain platform-specific binaries.

node_modules/
.next/
out/

.git/
.github/
.idea/
.vs/
.vscode/

# Never ship local environment files into an image.
.env
.env.*
!.env.example

coverage/
*.log
npm-debug.log*

k8s/
Dockerfile
.dockerignore
Jenkinsfile

*.md
